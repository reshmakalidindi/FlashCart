rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security enforcement
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isStaff() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isStaff == true ||
        request.auth.token.email.matches('.*staff.*')
      );
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // 2. Products Catalog - Read access for all users/shoppers. Write restricted to store staff/admin.
    match /products/{productId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // 3. Orders Collection - Authoritative Server Control
    // Shoppers can only read/create their own orders. Staff can inspect & perform exit verification on any order.
    match /orders/{orderId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaff());
      allow update: if isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['exitVerified', 'orderStatus', 'verifiedAt', 'verifiedBy']);
      allow delete: false;
    }
  }
}
