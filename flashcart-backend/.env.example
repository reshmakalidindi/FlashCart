# ==========================================
# FlashCart Backend Configuration
# Single Primary Database: MySQL 8 (PyMySQL)
# ==========================================

# 1. Primary Database Connection URL (MySQL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>?charset=utf8mb4
DATABASE_URL=mysql+pymysql://flashcart:your_secure_password@localhost:3306/flashcart?charset=utf8mb4

# 2. Alternatively configure granular parameters (if DATABASE_URL is not set):
MYSQL_USER=flashcart
MYSQL_PASSWORD=your_secure_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=flashcart
# Optional Unix Socket connection (e.g., macOS / Linux local socket):
# MYSQL_UNIX_SOCKET=/tmp/mysql.sock

# 3. Security & Authentication
# Generate a secure random key for production: openssl rand -hex 32
SECRET_KEY=replace_with_a_long_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 4. Store Metadata
STORE_ID=STORE_FLASHCART_001
STORE_NAME=FlashCart
CURRENCY_SYMBOL=₹
